  },
  "dependencies": {
    "@bn/schema": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "nanoid": "^5.0.9",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
