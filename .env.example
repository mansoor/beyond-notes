# Infrastructure only - runtime preferences live in the app's Settings UI.
# ASCII only in this file (Windows editors mangle anything else).

# Postgres (recommended). Use 127.0.0.1, not localhost (IPv6 gotcha).
DATABASE_URL=postgres://beyond:change-me@127.0.0.1:5432/beyond_notes
# SQLite light mode instead: DATABASE_URL=file:./data/beyond.db

PORT=3800
BASE_URL=http://127.0.0.1:3800

# Notifications are opt-in: reminders only push if ntfy is configured.
# Self-host ntfy or use ntfy.sh with a private topic name.
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=your-private-topic

# SMTP (optional). Enables the forgot-password flow, emailed invites, and the
# email notification channel. Leave unset and those flows stay hidden in the UI;
# the CLI rescue (user:reset-password) always works regardless.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notes@example.com
# SMTP_PASS=change-me
# MAIL_FROM="Beyond Notes <notes@example.com>"

# Used by docker-compose.yml for the postgres service
POSTGRES_PASSWORD=change-me
