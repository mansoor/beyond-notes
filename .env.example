# Infrastructure only - runtime preferences live in the app's Settings UI.
# ASCII only in this file (Windows editors mangle anything else).
#
# SMTP, ntfy (Settings > Notifications) and storage (Settings > Storage) can
# also be configured at runtime by an admin. Values saved there win over the
# env vars below; env remains the bootstrap and works headless.

# Postgres (recommended). Use 127.0.0.1, not localhost (IPv6 gotcha).
DATABASE_URL=postgres://beyond:change-me@127.0.0.1:5432/beyond_notes
# SQLite light mode instead: DATABASE_URL=file:./data/beyond.db

PORT=3800
BASE_URL=http://127.0.0.1:3800

# Notifications are opt-in: reminders only push if ntfy is configured.
# Self-host ntfy or use ntfy.sh with a private topic name.
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=your-private-topic

# SMTP (optional). Enables the forgot-password flow, emailed invites, and the
# email notification channel. Leave unset and those flows stay hidden in the UI;
# the CLI rescue (user:reset-password) always works regardless.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notes@example.com
# SMTP_PASS=change-me
# MAIL_FROM="Beyond Notes <notes@example.com>"

# S3-compatible blob storage (optional). Set S3_BUCKET to switch from the
# local uploads volume to S3 (MinIO, AWS, Wasabi, R2, B2). Leave S3_ENDPOINT
# empty for real AWS. Moving an existing library: cli blobs:migrate fs s3
# S3_BUCKET=beyond-notes
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# S3_FORCE_PATH_STYLE=true

# Single sign-on with OpenID Connect (optional): Authentik, Authelia, Keycloak,
# Pocket ID, Zitadel, Google, Entra ID... Setting OIDC_ISSUER and OIDC_CLIENT_ID
# turns it on. Register <BASE_URL>/auth/oidc/callback as the redirect URI at
# your provider. Everything here can also be set in Settings > Security, which
# then wins over env. Locked out? Run: cli sso:disable
# OIDC_ISSUER=https://auth.example.com/application/o/beyond-notes/
# OIDC_CLIENT_ID=beyond-notes
# OIDC_CLIENT_SECRET=change-me
# OIDC_SCOPES=openid email profile
# OIDC_BUTTON_LABEL=Authentik
# Make accounts for people who have none here (off = existing accounts only):
# OIDC_AUTO_CREATE=false
# OIDC_ALLOWED_DOMAINS=example.com,family.lan
# OIDC_REQUIRED_GROUP=beyond-notes-users
# Members of this group are admins; others are members (checked every sign-in):
# OIDC_ADMIN_GROUP=beyond-notes-admins
# OIDC_GROUPS_CLAIM=groups
# false = SSO only for members (admins keep a password fallback):
# OIDC_PASSWORD_LOGIN=true
# OIDC_AUTO_REDIRECT=false

# Sign-in through a reverse proxy / forward-auth (optional): Authelia, the
# Authentik proxy outpost, oauth2-proxy, Caddy or Traefik forward_auth. The
# proxy signs people in and passes their email in a header. That header is
# trusted ONLY from AUTH_PROXY_TRUSTED_IPS (the proxy's IPs or CIDRs); both must
# be set or this stays off. Make sure nothing else can reach the app directly
# from those addresses (do not publish the app's port past the proxy).
# Authelia:  Remote-Email / Remote-Name / Remote-Groups
# Authentik: X-authentik-email / X-authentik-name / X-authentik-groups
# AUTH_PROXY_EMAIL_HEADER=Remote-Email
# AUTH_PROXY_NAME_HEADER=Remote-Name
# AUTH_PROXY_GROUPS_HEADER=Remote-Groups
# AUTH_PROXY_TRUSTED_IPS=172.18.0.0/16
# AUTH_PROXY_AUTO_CREATE=false
# AUTH_PROXY_ADMIN_GROUP=beyond-notes-admins
# Where "Sign out" sends the browser, so the proxy doesn't sign you back in:
# AUTH_PROXY_LOGOUT_URL=https://auth.example.com/logout

# Behind a reverse proxy: the proxy's IPs/CIDRs, so the audit log (Settings >
# Activity) records the real client address from X-Forwarded-For. Only these
# hops may set that header. Empty = the AUTH_PROXY_TRUSTED_IPS list, if any.
# TRUST_PROXY=172.18.0.0/16
# Days of audit log to keep (sign-ins, security and admin changes). 0 = forever.
# AUDIT_RETENTION_DAYS=365

# Security headers (Content-Security-Policy etc.) on the app; published sites
# only get the harmless ones. Turn off only if your proxy sets its own.
# SECURITY_HEADERS=true
# Where vulnerability reports go, shown in /.well-known/security.txt
# SECURITY_CONTACT=mailto:security@example.com

# Prometheus metrics at /metrics, only when this is set. Scrape with the header
# "Authorization: Bearer <token>".
# METRICS_TOKEN=

# Check for a newer release (at most twice a day) and say so in About.
# UPDATE_CHECK=true

# Before an upgrade applies database migrations, a SQLite database is copied
# to BACKUPS_DIR as pre-upgrade-<time>.db (the last 3 are kept). On Postgres,
# take a pg_dump before upgrading; the log says when migrations are pending.

# Secrets saved in Settings (SMTP password, S3 secret key, SSO client secret) are
# AES-256-GCM encrypted at rest. The key comes from SECRETS_KEY (64 hex chars)
# or, if unset, is generated once and kept at SECRETS_KEY_FILE - outside the
# database, so a DB dump alone contains no usable credentials. Keep the key
# with your backups: without it those two secrets must be re-entered.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRETS_KEY=
# SECRETS_KEY_FILE=./data/secrets.key

# Where automatic/manual full backups (one zip each) are written. Under ./data
# by default, so it persists with the rest of your data volume. A backup holds
# everything including decrypted secrets - treat these files as sensitive.
# BACKUPS_DIR=./data/backups

# Concept-graph semantic layer (optional, off by default). ON runs a small
# local embedding model (transformers.js - no cloud, no API) in-process to add
# "related by meaning" edges the word-based graph can't find. The model (~30 MB)
# downloads once to GRAPH_EMBED_CACHE_DIR; mount that as a volume so a redeploy
# doesn't refetch. Off, or if the model can't load, the graph still shows
# links/tags/concepts. THRESHOLD is the cosine a page pair must clear (higher =
# fewer, tighter matches); NEIGHBORS caps edges per page.
# NOTE: the embedding runtime is not in the default (lean, Alpine) image. To use
# the semantic layer, run the "-ml" image tag (ghcr.io/.../beyond-notes:latest-ml),
# which is glibc-based and bundles it. On the default image, GRAPH_EMBEDDINGS=on
# simply falls back to the classical graph.
# GRAPH_EMBEDDINGS=false
# GRAPH_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# GRAPH_EMBED_CACHE_DIR=./data/models
# GRAPH_EMBED_THRESHOLD=0.55
# GRAPH_EMBED_NEIGHBORS=4

# Used by docker-compose.yml for the postgres service
POSTGRES_PASSWORD=change-me
