{
  "manifest_version": 3,
  "name": "Beyond Notes Clipper",
  "short_name": "BN Clipper",
  "version": "0.1.0",
  "description": "Save pages, selections and links to your Beyond Notes: into the Inbox or as a new page.",
  "homepage_url": "https://github.com/mansoor/beyond-notes",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Beyond Notes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib.js", "background.js"]
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the clipper"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clipper@beyondnotes.app",
      "strict_min_version": "121.0"
    }
  }
}
